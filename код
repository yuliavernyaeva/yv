<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Юлия Верняева</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,600;14..32,700&display=swap" rel="stylesheet" />
  <style>
    /* ========== ОБЩИЕ ПЕРЕМЕННЫЕ ========== */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    :root {
      --bg-dark: #1a1a1a;
      --bg-light: #ffffff;
      --text-light: #f5f5f5;
      --text-muted: #aaaaaa;
      --text-dark: #222222;
      --accent-gold: #c9a96e;
      --font-body: 'Inter', sans-serif;
    }
    html {
      scroll-behavior: smooth;
    }
    body {
      font-family: var(--font-body);
      background: var(--bg-dark);
      color: var(--text-light);
      line-height: 1.6;
      font-weight: 300;
      letter-spacing: 0.3px;
    }
    .container {
      max-width: 1100px;
      margin: 0 auto;
      padding: 0 20px;
    }
    /* ========== ШАПКА (белая) ========== */
    .header-white {
      background: var(--bg-light);
      padding: 25px 0;
      margin-bottom: 60px;
    }
    .header-flex {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 20px;
    }
    .logo-wrapper {
      display: flex;
      align-items: center;
      gap: 15px;
      text-decoration: none;
    }
    .logo-wrapper img {
      height: 60px;
      width: auto;
      display: block;
    }
    .logo-wrapper .logo-text {
      font-size: 1.2rem;
      font-weight: 600;
      letter-spacing: 1.5px;
      color: var(--text-dark);
      text-transform: uppercase;
    }
    .logo-wrapper .logo-text span {
      color: var(--accent-gold);
    }
    .nav a {
      margin-left: 35px;
      text-decoration: none;
      color: var(--text-dark);
      font-weight: 400;
      font-size: 0.9rem;
      letter-spacing: 1px;
      transition: 0.3s;
      border-bottom: 1px solid transparent;
      padding-bottom: 4px;
    }
    .nav a:hover {
      border-bottom-color: var(--accent-gold);
    }
    /* ========== КАРУСЕЛЬ ========== */
    .carousel-section {
      padding: 20px 0 50px;
      text-align: center;
    }
    .carousel-container {
      position: relative;
      overflow: hidden;
      max-width: 900px;
      margin: 0 auto 30px;
      background: var(--bg-dark);
    }
    .carousel-track {
      display: flex;
      transition: transform 0.6s ease-in-out;
    }
    .carousel-slide {
      min-width: 100%;
      display: flex;
      justify-content: center;
      align-items: center;
    }
    .carousel-slide img {
      width: 100%;
      max-height: 550px;
      object-fit: cover;
      display: block;
      filter: grayscale(0.1);
      transition: 0.5s;
    }
    .carousel-slide img:hover {
      filter: grayscale(0);
    }
    .carousel-btn {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      background: rgba(255,255,255,0.08);
      border: 1px solid rgba(255,255,255,0.15);
      color: var(--text-light);
      font-size: 2.2rem;
      padding: 12px 20px;
      cursor: pointer;
      transition: 0.3s;
      font-weight: 300;
      line-height: 1;
    }
    .carousel-btn:hover {
      background: rgba(255,255,255,0.15);
    }
    .carousel-btn.prev { left: 15px; }
    .carousel-btn.next { right: 15px; }
    .carousel-dots {
      display: flex;
      justify-content: center;
      gap: 14px;
      margin-top: 20px;
    }
    .carousel-dots span {
      width: 10px;
      height: 10px;
      background: rgba(255,255,255,0.2);
      border-radius: 50%;
      cursor: pointer;
      transition: 0.3s;
    }
    .carousel-dots span.active {
      background: var(--accent-gold);
      transform: scale(1.2);
    }
    .carousel-quote {
      max-width: 700px;
      margin: 30px auto 0;
      font-size: 1.6rem;
      font-weight: 300;
      letter-spacing: 0.5px;
      color: var(--text-light);
      line-height: 1.4;
    }
    .carousel-quote span {
      color: var(--accent-gold);
      font-weight: 400;
    }
    /* ========== БЛОК С КУКЛАМИ ========== */
    .dolls-section {
      padding: 60px 0 80px;
      border-top: 1px solid rgba(255,255,255,0.06);
    }
    .dolls-section .container {
      text-align: center;
    }
    .dolls-section h2 {
      font-size: 1.8rem;
      font-weight: 300;
      letter-spacing: 1px;
      margin-bottom: 30px;
      color: var(--text-light);
    }
    .dolls-section h2 span {
      color: var(--accent-gold);
      font-weight: 400;
    }
    .dolls-carousel {
      max-width: 800px;
      margin: 0 auto 35px;
    }
    .dolls-carousel .carousel-container {
      background: var(--bg-dark);
    }
    .dolls-carousel .carousel-slide img {
      max-height: 400px;
    }
    .dolls-link {
      display: inline-block;
      padding: 14px 50px;
      border: 1px solid var(--accent-gold);
      color: var(--accent-gold);
      text-decoration: none;
      font-size: 0.9rem;
      letter-spacing: 2px;
      text-transform: uppercase;
      transition: 0.3s;
      font-weight: 400;
    }
    .dolls-link:hover {
      background: var(--accent-gold);
      color: var(--bg-dark);
    }
    /* ========== ПОДВАЛ ========== */
    footer {
      padding: 40px 0 60px;
      text-align: center;
      border-top: 1px solid rgba(255,255,255,0.05);
      color: var(--text-muted);
      font-weight: 300;
      font-size: 0.8rem;
      letter-spacing: 1px;
    }
    /* ========== АДАПТИВНОСТЬ ========== */
    @media (max-width: 768px) {
      .header-flex { flex-direction: column; align-items: flex-start; }
      .nav a { margin-left: 0; margin-right: 25px; }
      .carousel-quote { font-size: 1.2rem; }
      .carousel-slide img { max-height: 350px; }
      .dolls-carousel .carousel-slide img { max-height: 280px; }
      .logo-wrapper img { height: 45px; }
    }
    @media (max-width: 480px) {
      .carousel-quote { font-size: 1rem; }
      .carousel-slide img { max-height: 250px; }
      .dolls-carousel .carousel-slide img { max-height: 200px; }
      .dolls-section h2 { font-size: 1.3rem; }
    }
  </style>
</head>
<body>

<!-- ========== ШАПКА (БЕЛАЯ) ========== -->
<header class="header-white">
  <div class="container header-flex">
    <a href="index.html" class="logo-wrapper">
      <img src="images/1.jpg" alt="Логотип Юлии Верняевой" />
      <span class="logo-text">YULIA <span>VERNYAEVA</span></span>
    </a>
    <div class="nav">
      <a href="#gallery">Фото</a>
      <a href="#dolls">Куклы</a>
      <a href="#contact">Связаться</a>
    </div>
  </div>
</header>

<!-- ========== ОСНОВНАЯ КАРУСЕЛЬ ========== -->
<section id="gallery" class="carousel-section">
  <div class="container">
    <!-- Карусель -->
    <div class="carousel-container" id="mainCarousel">
      <div class="carousel-track">
        <div class="carousel-slide"><img src="images/2.jpg" alt="Фото 2" /></div>
        <div class="carousel-slide"><img src="images/3.jpg" alt="Фото 3" /></div>
        <div class="carousel-slide"><img src="images/8.jpg" alt="Фото 8" /></div>
        <div class="carousel-slide"><img src="images/47.jpg" alt="Фото 47" /></div>
      </div>
      <button class="carousel-btn prev" onclick="moveSlide('mainCarousel', -1)">‹</button>
      <button class="carousel-btn next" onclick="moveSlide('mainCarousel', 1)">›</button>
    </div>
    <div class="carousel-dots" id="mainDots">
      <span class="active" onclick="goToSlide('mainCarousel', 0)"></span>
      <span onclick="goToSlide('mainCarousel', 1)"></span>
      <span onclick="goToSlide('mainCarousel', 2)"></span>
      <span onclick="goToSlide('mainCarousel', 3)"></span>
    </div>

    <!-- Выделенный текст -->
    <div class="carousel-quote">
      «Перевернула свою жизнь с ног на голову <br />и теперь занимаюсь только тем, что <span>искренне люблю</span>»
    </div>
  </div>
</section>

<!-- ========== БЛОК С КУКЛАМИ ========== -->
<section id="dolls" class="dolls-section">
  <div class="container">
    <h2>Уже больше <span>10 лет</span> создаю необыкновенных кукол <br />и учу этому других</h2>

    <!-- Карусель кукол -->
    <div class="dolls-carousel">
      <div class="carousel-container" id="dollsCarousel">
        <div class="carousel-track">
          <div class="carousel-slide"><img src="images/89.jpg" alt="Кукла 1" /></div>
          <div class="carousel-slide"><img src="images/72.jpg" alt="Кукла 2" /></div>
          <div class="carousel-slide"><img src="images/76.jpg" alt="Кукла 3" /></div>
        </div>
        <button class="carousel-btn prev" onclick="moveSlide('dollsCarousel', -1)">‹</button>
        <button class="carousel-btn next" onclick="moveSlide('dollsCarousel', 1)">›</button>
      </div>
      <div class="carousel-dots" id="dollsDots">
        <span class="active" onclick="goToSlide('dollsCarousel', 0)"></span>
        <span onclick="goToSlide('dollsCarousel', 1)"></span>
        <span onclick="goToSlide('dollsCarousel', 2)"></span>
      </div>
    </div>

    <!-- Ссылка на VK -->
    <a href="https://vk.ru/dreamdollspace" target="_blank" class="dolls-link">Моя страница в VK →</a>
  </div>
</section>

<!-- ========== ПОДВАЛ ========== -->
<footer id="contact">
  <div class="container">
    <p>© 2025 Юлия Верняева</p>
  </div>
</footer>

<!-- ========== СКРИПТ КАРУСЕЛИ ========== -->
<script>
  // Универсальная функция для каруселей
  const carousels = {};

  function initCarousel(id, dotId) {
    const container = document.getElementById(id);
    const track = container.querySelector('.carousel-track');
    const slides = track.querySelectorAll('.carousel-slide');
    const dots = document.getElementById(dotId).querySelectorAll('span');
    let current = 0;
    const total = slides.length;

    carousels[id] = { track, slides, dots, current, total };

    // Обновление отображения
    function update() {
      track.style.transform = `translateX(-${current * 100}%)`;
      dots.forEach((dot, i) => dot.classList.toggle('active', i === current));
    }

    // Привязываем функции к глобальному объекту, чтобы их можно было вызывать из onclick
    window.moveSlide = function(carouselId, direction) {
      const c = carousels[carouselId];
      if (!c) return;
      c.current = (c.current + direction + c.total) % c.total;
      c.track.style.transform = `translateX(-${c.current * 100}%)`;
      c.dots.forEach((dot, i) => dot.classList.toggle('active', i === c.current));
    };

    window.goToSlide = function(carouselId, index) {
      const c = carousels[carouselId];
      if (!c) return;
      c.current = index;
      c.track.style.transform = `translateX(-${c.current * 100}%)`;
      c.dots.forEach((dot, i) => dot.classList.toggle('active', i === c.current));
    };

    // Инициализация
    update();
  }

  // Запускаем карусели после загрузки страницы
  document.addEventListener('DOMContentLoaded', function() {
    initCarousel('mainCarousel', 'mainDots');
    initCarousel('dollsCarousel', 'dollsDots');
  });
</script>

</body>
</html>
